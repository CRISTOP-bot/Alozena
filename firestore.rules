rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost(stayId) {
      return signedIn() && get(/databases/$(database)/documents/stays/$(stayId)).data.hostUid == request.auth.uid;
    }
    function validDate(value) { return value is timestamp; }
    function validDateOrder() { return request.resource.data.checkIn < request.resource.data.checkOut; }
    function validBookingCreate() {
      let stayPath = /databases/$(database)/documents/stays/$(request.resource.data.stayId);
      return request.resource.data.keys().hasOnly(['guestUid', 'stayId', 'checkIn', 'checkOut', 'guests', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['guestUid', 'stayId', 'checkIn', 'checkOut', 'guests', 'status', 'createdAt'])
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.stayId is string
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time
        && validDate(request.resource.data.checkIn)
        && validDate(request.resource.data.checkOut)
        && validDateOrder()
        && request.resource.data.guests is int && request.resource.data.guests > 0
        && exists(stayPath) && get(stayPath).data.published == true
        && request.resource.data.guests <= get(stayPath).data.maxGuests;
    }
    function validBookingCancellation() {
      return resource.data.guestUid == request.auth.uid
        && resource.data.status == 'requested'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /stays/{stayId} {
      allow read: if resource.data.published == true || (signedIn() && resource.data.hostUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.location is string
        && request.resource.data.category is string
        && request.resource.data.pricePerNight is int
        && request.resource.data.pricePerNight > 0
        && request.resource.data.maxGuests is int
        && request.resource.data.maxGuests > 0
        && request.resource.data.published == false;
      allow update: if signedIn() && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.published == resource.data.published;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid && resource.data.published == false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl is string);
      allow delete: if false;
      match /favorites/{stayId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['stayId', 'createdAt'])
          && request.resource.data.keys().hasAll(['stayId', 'createdAt'])
          && request.resource.data.stayId == stayId
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/stays/$(stayId));
        allow update: if false;
      }
    }

    match /bookings/{bookingId} {
      allow create: if signedIn() && validBookingCreate();
      allow list: if signedIn() && resource.data.guestUid == request.auth.uid;
      allow get: if signedIn() && (resource.data.guestUid == request.auth.uid || isHost(resource.data.stayId));
      allow update: if signedIn() && validBookingCancellation();
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
