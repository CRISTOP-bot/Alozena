rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownStay(stayId) {
      return signedIn()
        && exists(/databases/$(database)/documents/stays/$(stayId))
        && get(/databases/$(database)/documents/stays/$(stayId)).data.hostUid == request.auth.uid;
    }
    function validBookingCreate() {
      let stayPath = /databases/$(database)/documents/stays/$(request.resource.data.stayId);
      return request.resource.data.keys().hasOnly(['guestUid', 'stayId', 'hostUid', 'stayTitle', 'nightlyPrice', 'cleaningFee', 'securityDeposit', 'checkIn', 'checkOut', 'guests', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['guestUid', 'stayId', 'hostUid', 'stayTitle', 'nightlyPrice', 'cleaningFee', 'securityDeposit', 'checkIn', 'checkOut', 'guests', 'status', 'createdAt'])
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.stayId is string
        && request.resource.data.hostUid == get(stayPath).data.hostUid
        && request.resource.data.stayTitle is string
        && request.resource.data.nightlyPrice is int && request.resource.data.nightlyPrice > 0
        && request.resource.data.cleaningFee is int && request.resource.data.cleaningFee >= 0
        && request.resource.data.securityDeposit is int && request.resource.data.securityDeposit >= 0
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.checkIn is timestamp
        && request.resource.data.checkOut is timestamp
        && request.resource.data.checkIn < request.resource.data.checkOut
        && request.resource.data.guests is int && request.resource.data.guests > 0
        && exists(stayPath) && get(stayPath).data.published == true
        && request.resource.data.guests <= get(stayPath).data.maxGuests;
    }
    function validBookingCancellation() {
      return resource.data.guestUid == request.auth.uid
        && resource.data.status == 'requested'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
    function validHostResponse() {
      return resource.data.hostUid == request.auth.uid
        && resource.data.status == 'requested'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.hostRespondedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'hostRespondedAt']);
    }

    match /stays/{stayId} {
      allow read: if resource.data.published == true || (signedIn() && resource.data.hostUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'location', 'category', 'pricePerNight', 'cleaningFee', 'securityDeposit', 'maxGuests', 'beds', 'description', 'coverImageUrl', 'searchTokens', 'source', 'hostUid', 'hostDisplayName', 'published', 'moderationStatus', 'createdAt', 'reviewCount'])
        && request.resource.data.keys().hasAll(['title', 'location', 'category', 'pricePerNight', 'cleaningFee', 'securityDeposit', 'maxGuests', 'beds', 'description', 'coverImageUrl', 'searchTokens', 'source', 'hostUid', 'hostDisplayName', 'published', 'moderationStatus', 'createdAt', 'reviewCount'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostDisplayName is string
        && request.resource.data.title is string && request.resource.data.title.size() >= 5 && request.resource.data.title.size() <= 90
        && request.resource.data.location is string && request.resource.data.location.size() >= 3 && request.resource.data.location.size() <= 120
        && request.resource.data.category in ['Casa', 'Departamento', 'Cabaña', 'Habitación', 'Otro']
        && request.resource.data.pricePerNight is int && request.resource.data.pricePerNight > 0 && request.resource.data.pricePerNight <= 10000000
        && request.resource.data.cleaningFee is int && request.resource.data.cleaningFee >= 0 && request.resource.data.cleaningFee <= 10000000
        && request.resource.data.securityDeposit is int && request.resource.data.securityDeposit >= 0 && request.resource.data.securityDeposit <= 10000000
        && request.resource.data.maxGuests is int && request.resource.data.maxGuests > 0 && request.resource.data.maxGuests <= 30
        && request.resource.data.beds is int && request.resource.data.beds >= 0 && request.resource.data.beds <= 30
        && request.resource.data.description is string && request.resource.data.description.size() >= 20 && request.resource.data.description.size() <= 2000
        && request.resource.data.coverImageUrl is string && request.resource.data.coverImageUrl.matches('https://.*')
        && request.resource.data.source == 'host_submitted'
        && request.resource.data.searchTokens is list
        && request.resource.data.published == true
        && request.resource.data.moderationStatus == 'host_attested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewCount == 0;
      allow update: if signedIn() && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.published == resource.data.published
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'location', 'category', 'pricePerNight', 'cleaningFee', 'securityDeposit', 'maxGuests', 'beds', 'description', 'coverImageUrl', 'searchTokens']);
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl is string);
      allow delete: if false;
      match /favorites/{stayId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['stayId', 'createdAt'])
          && request.resource.data.keys().hasAll(['stayId', 'createdAt'])
          && request.resource.data.stayId == stayId
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/stays/$(stayId));
        allow update: if false;
      }
    }

    match /bookings/{bookingId} {
      allow create: if signedIn() && validBookingCreate();
      allow list: if signedIn() && (resource.data.guestUid == request.auth.uid || resource.data.hostUid == request.auth.uid);
      allow get: if signedIn() && (resource.data.guestUid == request.auth.uid || ownStay(resource.data.stayId));
      allow update: if signedIn() && (validBookingCancellation() || validHostResponse());
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
